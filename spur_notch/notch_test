void iirNotchCoef(double *b,double *a,double f0,double Q,double fs) 
{
    if (f0!=0) {
        double w0 = 2.0*M PI*f0/fs;
        double attenuate = 0.707;
        double alpha = tan(w0/Q/2.0) *sqrt(1- attenuate*attenuate)/attenuate;
        b[0] = 1.0;
        b[1] = -2.0*cos(w0);
        b[2] = 1.0 ;
        a[0] = 1+alpha;
        a[1] = -2.0*cos(w0);
        a[2] = 1-alpha;
        double a0=a[0];
        for (int i=0;i<3;i++)
        {
            b[i] /= a0;
            a[i] /= a0;
        }
    } else {
        double rou = 0.965;
        b[0] = 1.0;
        b[1] = -2.0 ;
        b[2] = 1.0;
        a[0] = 1.0;
        a[1] = -2 *rou;
        a[2] = rou*rou

    }
}


void IIR_FILTER_CLASS::setCoefFixed(int rxIdx)
{
    iirNotchFixedSettingFlag=1;
    inputBits = gSetting.RX_TIME_CTRL.syncDfeFixedBits;
    inputClip=gSetting.RX_TIME_CTRL.syncDfeFixedClip;
    coefBitsA = gSetting.SINGLE_TONE_SPUR_CTRL.notchCoefFixedBitsA;
    coefBitsClipA = gSetting.SINGLE_TONE_SPUR_CTRL.notchCoefFixedClipA;
    coefFractionBitsA = coefBitsA -(int)(log10(coefBitsClipA)/log10(2.0)+0.5) -1 ;

    coefBitsB = gSetting.SINGLE_TONE_SPUR_CTRL.notchCoefFixedBitsB;
    coefBitsClipB = gSetting.SINGLE_TONE_SPUR_CTRL.notchCoefFixedClipB;
    coefFractionBitsB = coefBitsB - (int)(log10(coefBitsClipB)/log10(2.0+0.5)-1 ;

    for(int i=0;i<3;i++)
    {
        X_CoefFixed[i] = float2FixedIntOut(X_Coef[i],coefBitsClipB,coefBitsB,SYMMETRIC);
        Y_CoefFixed[i] = float2FixedIntOut(Y_Coef[i],coefBitsClipA,coefBitsA,SYMMETRIC );

    }

}

int float2FixedIntOut(double data , double clipping ,int Bits ,int symmetryFlag)
{
    int max=1<<(Bits - 1);
    double temp=data/clipping*max;
    if(temp>=0) temp=(int)(temp+0.5);
    else temp = (int)(temp-0.5);
    if (symmetryFlag==1)
    {
        if (temp>max-1) temp=max-1;
        else if (temp <-(max-1))
        {
            temp = -(max-1) ;
        }
    }else 
    {
        if (temp>max-1) temp=max-1;
        else if (temp <-max)
        {
            temp = -max ;
        }        
    }
    return (int)temp;
}



void IIR_FILTER_CLASS::setCoef(double *B,double *A,int order)
{
    if(initFlag==1) freeMemory();
    initFlag = 1;
    int i ;
    TapsNum = order ;
    X_Coef = new double[TapsNum+1];
    Y_Coef = new double[TapsNum+1];
    Reg = new Complex [TapsNum];

    for(int i=0 ;i <=TapsNum ;i++)
    {
        X_Coef[i] = B[i];
        Y_Coef[i] = A[i];
    }
    if (Y_Coef[0] != 1.0)
    {
        for(i = TapsNum;i>=0 ;i--)
        {
            X_Coef[i]/=Y_Coef[0];
            Y_Coef[i]/=Y_Coef[0];
        }
    }
    initial();
    iirNotchFixedSettingFlag = 0;

}
