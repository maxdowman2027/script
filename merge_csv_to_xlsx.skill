{"name": "merge_csv_to_xlsx", "description": "合并risc_wifitx格式的CSV文件到XLSX文件，按channel和编码方式（BCC/LDPC）划分Sheet", "author": "gxu", "version": "1.0", "category": "数据处理", "tags": ["CSV合并", "XLSX生成", "WiFi测试数据处理"], "requirements": ["pandas", "openpyxl"], "parameters": [{"name": "input_dir", "type": "string", "required": false, "default": "D:/chip_test/dev/xian_test/Xian-Esp-Test-Scripts/py_script_fpga_tx_wifi7/Log/wifi_tx_rls4/no_he", "description": "输入文件夹路径，包含要合并的CSV文件"}, {"name": "output_file", "type": "string", "required": false, "default": "D:/chip_test/dev/xian_test/Xian-Esp-Test-Scripts/py_script_fpga_tx_wifi7/Log/wifi_tx_rls4/no_he/merged_result.xlsx", "description": "输出的XLSX文件路径"}], "example": {"command": "python merge_csv_to_xlsx.py", "description": "运行脚本来合并指定文件夹中的CSV文件到XLSX文件"}, "notes": ["脚本会自动查找risc_wifitx_*.csv格式的文件", "根据文件名中的channel和编码方式（BCC/LDPC）划分Sheet", "Sheet命名格式为channel{channel}_{coding}"]}