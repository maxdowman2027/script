.photo-card {
  margin-bottom: 28rpx;
}

.cover {
  position: relative;
  height: 420rpx;
  background: var(--surface-2);
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
}

.cover-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.like {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
}

.meta {
  padding: 20rpx 24rpx 24rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.tags {
  flex: 1;
  text-align: right;
}
