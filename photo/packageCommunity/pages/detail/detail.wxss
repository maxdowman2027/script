.hero {
  height: 760rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-title {
  font-size: 48rpx;
  padding: 40rpx;
}

.body {
  padding: 32rpx var(--spacing-page);
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 650;
  margin-bottom: 8rpx;
}

.scene {
  margin-top: 24rpx;
}
