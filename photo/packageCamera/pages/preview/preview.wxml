<view class="page preview">
  <empty-state
    wx:if="{{!ok}}"
    title="无法预览"
    desc="{{error}}"
    actionText="返回拍摄"
    bindaction="onBackCamera"
  />

  <block wx:else>
    <image class="photo" src="{{tempFilePath}}" mode="aspectFit" />
    <view class="panel">
      <view class="label">作品标题</view>
      <input class="input" maxlength="24" placeholder="给这张照片起个名字" value="{{title}}" bindinput="onTitle" />

      <view class="label">标签</view>
      <view class="chips">
        <view
          class="tag {{selectedMap[item] ? 'active' : ''}}"
          wx:for="{{allTags}}"
          wx:key="*this"
          data-tag="{{item}}"
          bindtap="onToggleTag"
        >{{item}}</view>
      </view>
      <input class="input" maxlength="8" placeholder="自定义标签，回车添加" value="{{customTag}}" bindinput="onCustomInput" bindconfirm="onAddCustom" />

      <view class="muted">将压缩后上传，并提交内容安全审核。审核通过后出现在灵感广场。</view>
      <view class="btn-primary {{publishing ? 'disabled' : ''}}" bindtap="onPublish">{{publishing ? '发布中…' : '发布到社区'}}</view>
    </view>
  </block>

  <view wx:if="{{publishing}}" class="loading-mask">
    <view class="loading-box">压缩并审核中…</view>
  </view>
</view>
